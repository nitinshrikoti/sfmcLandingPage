%%[
/* =====================================================================
   WEBINAR LANDING PAGE: DATA LOAD ONLY
   (form fields, validation and UpsertDE removed)
   ===================================================================== */

VAR @webinarId, @wRows, @wRow
VAR @topicId, @tRows, @tRow
VAR @expertId, @dRows, @dRow
VAR @startDT
VAR @pageOk, @pageError

SET @pageOk    = true
SET @pageError = ""

/* ---------------------------------------------------------------
   1. READ URL PARAM
   Preview by opening the CloudPage with ?id=real id
   --------------------------------------------------------------- */
SET @webinarId = Trim(RequestParameter("id"))
IF EMPTY(@webinarId) THEN
  SET @webinarId = Trim(RequestParameter("webinarId"))
ENDIF

IF EMPTY(@webinarId) THEN
  SET @pageOk    = false
  SET @pageError = "Missing webinar id"
ENDIF

/* ---------------------------------------------------------------
   2. LOOKUP WEBINAR (PRIMARY DE)
   Field(row, col, 0) returns "" instead of throwing if a column
   is missing or renamed.
   --------------------------------------------------------------- */
IF @pageOk == true THEN
  SET @wRows = LookupRows("Webinar_Landing_Pages", "Id", @webinarId)

  IF RowCount(@wRows) == 0 THEN
    SET @pageOk    = false
    SET @pageError = "Invalid webinar id"
  ELSE
    SET @wRow     = Row(@wRows, 1)
    SET @topicId  = Field(@wRow, "Webinar_Topic__c", 0)
    SET @expertId = Field(@wRow, "Expert_Name__c", 0)
    SET @startDT  = Field(@wRow, "Start_Datetime__c", 0)
  ENDIF
ENDIF

/* ---------------------------------------------------------------
   3. VALIDATE REQUIRED CONFIG ON THE WEBINAR ROW
   --------------------------------------------------------------- */
IF @pageOk == true THEN
  IF EMPTY(@topicId) OR EMPTY(@expertId) OR EMPTY(@startDT) THEN
    SET @pageOk    = false
    SET @pageError = "Webinar configuration incomplete"
  ENDIF
ENDIF

/* ---------------------------------------------------------------
   4. LOOKUP TOPIC + DOCTOR
   --------------------------------------------------------------- */
IF @pageOk == true THEN
  SET @tRows = LookupRows("Webinar_Topic_Data", "Id", @topicId)
  SET @dRows = LookupRows("Webinar_Doctors_List", "Id", @expertId)

  IF RowCount(@tRows) == 0 THEN
    SET @pageOk    = false
    SET @pageError = "Invalid topic mapping"
  ELSEIF RowCount(@dRows) == 0 THEN
    SET @pageOk    = false
    SET @pageError = "Invalid doctor mapping"
  ELSE
    SET @tRow = Row(@tRows, 1)
    SET @dRow = Row(@dRows, 1)
  ENDIF
ENDIF

/* ---------------------------------------------------------------
   5. UPCOMING WEBINARS FOR THE SLIDER
   --------------------------------------------------------------- */
VAR @upRows, @upCount, @i, @upRow, @upTopic, @upExpert, @shown

VAR @myTopic
SET @myTopic = Trim(Field(@wRow, "TopicName", 0))
IF EMPTY(@myTopic) THEN SET @myTopic = Trim(@topicId) ENDIF

SET @upRows  = LookupOrderedRows("Webinar_Landing_Pages", 0, "Start_Datetime__c ASC",
                                 "Status__c", "Active",
                                 "ShowInSlider", "true")
SET @upCount = RowCount(@upRows)

SET @shown = 0
IF @upCount > 0 THEN
  FOR @i = 1 TO @upCount DO
    SET @upRow = Row(@upRows, @i)
    IF Field(@upRow, "Id", 0) != @webinarId AND Trim(Field(@upRow, "TopicName", 0)) == @myTopic THEN
      SET @shown = Add(@shown, 1)
    ENDIF
  NEXT @i
ENDIF
]%%

